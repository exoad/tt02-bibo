# What the editor needs to parse the viewer's test suite. Mirrors the link suite
# in tools/test.bat; when its include list moves, this one moves with it.
#
# ../src must come before ../../firmware/pilot/src: both have a link.hxx, and this
# suite includes the viewer's.
#
# Relative paths, resolved against viewer/tests: tools/style_audit.py fails on a
# path naming a home directory.
CompileFlags:
  Add:
    - -std=c++20
    - -I../src
    - -I../../firmware/lib
    - -I../../firmware/pilot/src
    - -I../../third_party/imgui
    # stb_image, for the camera decode this suite exercises through jpeg.cxx.
    - -I../../third_party/stb
    - -D_CRT_SECURE_NO_WARNINGS
    # MSVC's <yvals_core.h> fails with STL1000 on any Clang older than 19, and
    # clangd here is older; the real build is cl.exe.
    - -D_ALLOW_COMPILER_AND_STL_VERSION_MISMATCH
