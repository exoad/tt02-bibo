# Include paths for clangd. viewer/build.bat is the real build and there is no
# compile_commands.json here, so without these clangd reports shared.hxx not
# found in files that compile clean at /W4.
#
# RELATIVE, resolved against this directory: tools/style_audit.py fails the
# build on an absolute user path. Unlike firmware/pilot/, no hand-written
# compile_commands.json is needed; the fallback command covers a new file.
CompileFlags:
  Add:
    - -std=c++20
    - -I../../firmware/lib
    # For bibowire.hxx; build.bat compiles bibowire.cxx into this exe from there.
    - -I../../firmware/pilot/src
    - -I../../third_party/imgui
    - -I../../third_party/imgui/backends
    # stb_image, for the camera window's JPEG decode (gitignored and cloned).
    - -I../../third_party/stb
    - -D_CRT_SECURE_NO_WARNINGS
    # MSVC's <yvals_core.h> fails any Clang older than 19 (STL1000) before our
    # code is read. The real build is cl.exe, so this is for the editor only,
    # as in firmware/pilot/compile_commands.json.
    - -D_ALLOW_COMPILER_AND_STL_VERSION_MISMATCH
