// Windows resources for tt02.exe.
//
// The icon is generated, not hand-drawn in an editor: assets/make_icon.ps1
// renders it at every size from the same graphite plate, top bevel and cyan LED
// accents the UI is built from. Re-run that script after changing the theme so
// the two do not drift apart.

#include "resource.h"

// The FIRST icon in a .rc is what Explorer and the taskbar use for the
// executable, which is why this is ID 1 and why nothing else may be added above
// it. The window class picks the same one up by name at runtime.
IDI_APPICON ICON "..\\assets\\tt02.ico"

// ---------------------------------------------------------------------------

1 VERSIONINFO
FILEVERSION     0,3,0,0
PRODUCTVERSION  0,3,0,0
FILEFLAGSMASK   0x3fL
FILEFLAGS       0x0L
FILEOS          0x40004L      // VOS_NT_WINDOWS32
FILETYPE        0x1L          // VFT_APP
FILESUBTYPE     0x0L
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"      // US English, Unicode
        BEGIN
            VALUE "CompanyName",      "tt02-auto"
            VALUE "FileDescription",  "tt02-auto control hub"
            VALUE "FileVersion",      "0.3.0.0"
            VALUE "InternalName",     "tt02"
            VALUE "LegalCopyright",   "Icons: Fugue Icons by Yusuke Kamiyamane, CC BY 3.0"
            VALUE "OriginalFilename", "tt02.exe"
            VALUE "ProductName",       "tt02-auto"
            VALUE "ProductVersion",   "0.3.0.0"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END
