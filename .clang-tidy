# .clangd's check list, for clang-tidy, CI and CLion's inspection, which do not
# read .clangd. Without this file clang-tidy runs its default checks and reports
# almost nothing, which reads like a clean file. Keep the two lists in step.

Checks: >
  -*,
  bugprone-*,
  clang-analyzer-*,
  performance-*,
  portability-*,
  modernize-use-nullptr,
  modernize-use-override,
  modernize-use-using,
  modernize-loop-convert,
  readability-braces-around-statements,
  -bugprone-easily-swappable-parameters,
  -bugprone-unhandled-exception-at-new

# Ours only; vendor/ and third_party/ are upstream.
HeaderFilterRegex: '(viewer[/\\]src|firmware[/\\]lib|shared|pilot[/\\]src)'

FormatStyle: none
