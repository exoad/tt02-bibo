# Cloned, not tracked; see THIRD_PARTY.md.
vendor/

# Telemetry pulled off the SD card.
data/*.csv

build/
**/build/

# Firmware build outputs.
*.uf2
*.elf
*.bin
*.hex
*.map

# MSVC build outputs.
*.obj
*.pdb
*.ilk
*.idb
*.exp
*.lib
*.exe
*.dll
*.iobj
*.ipdb
*.tlog
.vs/

# Dear ImGui's window layout, written at runtime.
imgui.ini

# A .pyc embeds the absolute path of its source, and git grep -I skips binaries,
# so a committed one leaks a home directory that no sweep can see.
__pycache__/
*.pyc
*.pyo

.DS_Store
Thumbs.db
desktop.ini

# The Dear ImGui and stb clones the viewer builds against; versions in THIRD_PARTY.md.
third_party/

# Per-machine CLion and CMake state; firmware/CMakePresets.json and the run
# configurations are committed. firmware/build-pico2/ is the car's board,
# firmware/build-debug/ the Debug preset's.
firmware/build-*/
cmake-build-*/
/.idea/workspace.xml
/.idea/httpRequests/
/.idea/shelf/
/.idea/*.iml
/.idea/modules.xml

# Agent tooling, local only.
.claude/
CLAUDE.md
.cursor/
.aider*

/logs/

# Its entries carry absolute paths. firmware/pilot/compile_commands.json is
# hand-written with relative paths and committed on purpose.
firmware/tests/compile_commands.json

# clangd index cache: binary, with absolute paths inside.
.cache/
tools/npu/frames/
tools/npu/runs/
tools/npu/samples/
tools/npu/eval/
# The car model for the 3D view: the operator's download, dropped in by hand (viewer/README.md).
viewer/assets/
