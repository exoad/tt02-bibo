# Vendored third-party source. Cloned, not tracked - see README for the pin.
vendor/

# Telemetry pulled off the SD card.
data/*.csv

# Build trees (firmware, host, viewer, bridge).
build/
**/build/

# Firmware artifacts
*.uf2
*.elf
*.bin
*.hex
*.map

# MSVC / Windows build artifacts.
#
# *.obj also matches Wavefront OBJ models, which are ASSETS and must ship.
# The negation has to name the directory explicitly - a bare !*.obj would
# re-admit every compiler output too.
*.obj
!hub/assets/models/*.obj
*.pdb
*.ilk
*.idb
*.exp
*.lib
*.exe
*.dll
*.iobj
*.ipdb
*.tlog
.vs/

# Dear ImGui writes window layout here at runtime.
imgui.ini

# Go
/host/bin/

# OS noise
.DS_Store
Thumbs.db
desktop.ini

# Vendored Dear ImGui clone - pinned tag recorded in lidar/README.md.
hub/third_party/

# CLion / CMake. The presets and run configurations ARE committed - they carry
# the toolchain knowledge and are the point of the setup. Everything below is
# per-machine state that would only cause conflicts.
# Every per-board build tree: build/ is the Pico 2 W, build-pico2/ is the car's
# board. build-debug/ predates both.
firmware/build-*/
cmake-build-*/
/.idea/workspace.xml
/.idea/httpRequests/
/.idea/shelf/
/.idea/*.iml
/.idea/modules.xml

# Agent / assistant tooling. Local scratch, never part of the project.
.claude/
CLAUDE.md
.cursor/
.aider*

# Session logs, one per launch. Local diagnostics only - never leaves the
# machine, and pruned to the last 20 sessions by applog.cpp.
/logs/
