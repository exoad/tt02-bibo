# Vendored third-party source. Cloned, not tracked - see THIRD_PARTY.md.
vendor/

# Telemetry pulled off the SD card.
data/*.csv

# Build trees.
build/
**/build/

# Firmware artifacts
*.uf2
*.elf
*.bin
*.hex
*.map

# MSVC / Windows build artifacts.
*.obj
*.pdb
*.ilk
*.idb
*.exp
*.lib
*.exe
*.dll
*.iobj
*.ipdb
*.tlog
.vs/

# Dear ImGui writes window layout here at runtime.
imgui.ini

# Python bytecode caches.
#
# NOT MERELY NOISE. A .pyc embeds the ABSOLUTE PATH of the source it was
# compiled from, so a committed one carries this machine's home directory - and
# `git grep -I` skips binary files, so no sweep for home paths can see it. A
# file nothing can read is a file nothing can check.
__pycache__/
*.pyc
*.pyo

# OS noise
.DS_Store
Thumbs.db
desktop.ini

# The Dear ImGui and stb clones the viewer builds against - versions in
# THIRD_PARTY.md.
third_party/

# CLion / CMake. firmware/CMakePresets.json and the run configurations ARE
# committed - they carry the toolchain knowledge and are the point of the setup.
# Everything below is per-machine state that would only cause conflicts.
# Every per-board build tree: build/ is the Pico 2 W, build-pico2/ is the car's
# board, build-debug/ is the Debug preset's.
firmware/build-*/
cmake-build-*/
/.idea/workspace.xml
/.idea/httpRequests/
/.idea/shelf/
/.idea/*.iml
/.idea/modules.xml

# Agent / assistant tooling. Local scratch, never part of the project.
.claude/
CLAUDE.md
.cursor/
.aider*

# Old session logs at the root. Local diagnostics only.
/logs/

# Generated so an editor can parse the host test suites, which are built by .bat
# and appear in no CMake project.
#
# NOT COMMITTED: the entries carry ABSOLUTE paths, so the file names this
# machine and is wrong on any other. Same reason the .pyc had to go.
#
# firmware/pilot/compile_commands.json is deliberately NOT here: it is written
# by hand, carries no absolute path, and is committed on purpose.
firmware/tests/compile_commands.json

# clangd index cache. Binary, machine-specific, and it embeds absolute paths -
# the same property that put a .pyc with a home directory into 119 commits.
.cache/
