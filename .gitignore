# Vendored third-party source. Cloned, not tracked - see README for the pin.
vendor/

# Telemetry pulled off the SD card.
data/*.csv

# Build trees (firmware, host, viewer, bridge).
build/
**/build/

# Firmware artifacts
*.uf2
*.elf
*.bin
*.hex
*.map

# MSVC / Windows build artifacts.
#
# *.obj also matches Wavefront OBJ models, which are ASSETS and must ship.
# The negation has to name the directory explicitly - a bare !*.obj would
# re-admit every compiler output too.
*.obj
!hub/assets/models/*.obj
*.pdb
*.ilk
*.idb
*.exp
*.lib
*.exe
*.dll
*.iobj
*.ipdb
*.tlog
.vs/

# Dear ImGui writes window layout here at runtime.
imgui.ini

# Python bytecode caches, from hub/tools.
#
# NOT MERELY NOISE. A .pyc embeds the ABSOLUTE PATH of the source it was
# compiled from, so hub/tools/__pycache__/livery.cpython-313.pyc carried this
# machine's home directory - and carried it past three separate sweeps for
# exactly that, because `git grep -I` skips binary files and every one of those
# sweeps used it. A file nothing can read is a file nothing can check.
__pycache__/
*.pyc
*.pyo

# Go
/host/bin/

# OS noise
.DS_Store
Thumbs.db
desktop.ini

# Vendored Dear ImGui clone - pinned tag recorded in lidar/README.md.
hub/third_party/

# CLion / CMake. The presets and run configurations ARE committed - they carry
# the toolchain knowledge and are the point of the setup. Everything below is
# per-machine state that would only cause conflicts.
# Every per-board build tree: build/ is the Pico 2 W, build-pico2/ is the car's
# board. build-debug/ predates both.
firmware/build-*/
cmake-build-*/
/.idea/workspace.xml
/.idea/httpRequests/
/.idea/shelf/
/.idea/*.iml
/.idea/modules.xml

# Agent / assistant tooling. Local scratch, never part of the project.
.claude/
CLAUDE.md
.cursor/
.aider*

# Session logs, one per launch. Local diagnostics only - never leaves the
# machine, and pruned to the last 20 sessions by applog.cpp.
/logs/

# Generated by hub/tools/gen_test_db.py so an editor can parse the host test
# suites, which are built by .bat and appear in no CMake project.
#
# NOT COMMITTED: the entries carry ABSOLUTE paths, so the file names this
# machine and is wrong on any other. Same reason the .pyc had to go.
firmware/tests/compile_commands.json
hub/tests/compile_commands.json
hub/src/compile_commands.json
