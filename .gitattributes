# Set here rather than guessed per file and machine: a .bat checked out with LF can
# fail like a broken script, and a mis-detected binary shows up as a huge diff.
# LF in the repository; working-copy endings follow the platform.
* text=auto

# cmd.exe mishandles LF in some cases, PowerShell here-strings among them.
*.bat  text eol=crlf
*.cmd  text eol=crlf
*.ps1  text eol=crlf

*.sh   text eol=lf

*.c    text
*.h    text
*.cpp  text
*.hpp  text
*.py   text
*.md   text
*.txt  text
*.json text
*.rc   text
*.cmake text
CMakeLists.txt text

*.png  binary
*.ico  binary
*.jpg  binary
*.uf2  binary
*.elf  binary
*.bin  binary
*.lib  binary
*.dll  binary
*.exe  binary
*.zip  binary
*.ttf  binary

# Untracked today; if ever added, kept out of GitHub's language statistics.
vendor/**            linguist-vendored
third_party/**       linguist-vendored
