# Repo-wide clangd settings. clangd merges every .clangd from a file's directory up to the
# root, so the directory files keep their databases and the check list lives here once.
#
# With no ClangTidy list clangd 18 runs no checks, whatever --clang-tidy says. `clangd
# --check` never runs clang-tidy, so it calls a file clean however this is written.

Diagnostics:
  ClangTidy:
    Add:
      # Defects rather than taste.
      - bugprone-*
      - clang-analyzer-*
      - performance-*
      - portability-*
      # One by one: modernize-* would also demand trailing return types and ban the C arrays
      # firmware uses on purpose.
      - modernize-use-nullptr
      - modernize-use-override
      - modernize-use-using
      - modernize-loop-convert
      # conventions.md braces every body; this reports a braceless one as you type.
      - readability-braces-around-statements

    Remove:
      # Fires on any two parameters of one type: most of the geometry and every begin/end
      # pair.
      - bugprone-easily-swappable-parameters
      # The firmware is freestanding: no exceptions, no heap.
      - bugprone-unhandled-exception-at-new
