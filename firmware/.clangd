# Fallback for a firmware file parsed without the CMake project attached (docs/hardware.md,
# "In CLion"). firmware/ cross-compiles for arm-none-eabi, so until it is attached a file here
# belongs to no project; build.bat writes the full include set to build/compile_commands.json
# on every configure.

CompileFlags:
  CompilationDatabase: build

  # ARM compiler flags a host parser reports as unknown arguments.
  Remove:
    - -mcpu=*
    - -mthumb
    - -mfloat-abi=*
    - -mfpu=*
    - --specs=*

  # clangd guesses an LLVM embedded toolchain's header layout for arm-none-eabi-g++, which
  # does not exist here, so <cstddef> fails. These are what `arm-none-eabi-g++ -x c++ -E -v`
  # prints, in its order; when MSYS2's toolchain moves or updates, paste its new list.
  Add:
    - -isystem
    - C:/msys64/mingw64/arm-none-eabi/include/c++/13.3.0
    - -isystem
    - C:/msys64/mingw64/arm-none-eabi/include/c++/13.3.0/arm-none-eabi
    - -isystem
    - C:/msys64/mingw64/arm-none-eabi/include/c++/13.3.0/backward
    - -isystem
    - C:/msys64/mingw64/lib/gcc/arm-none-eabi/13.3.0/include
    - -isystem
    - C:/msys64/mingw64/lib/gcc/arm-none-eabi/13.3.0/include-fixed
    - -isystem
    - C:/msys64/mingw64/arm-none-eabi/include

Diagnostics:
  # The SDK's own headers are not ours to fix.
  Suppress:
    - pp_file_not_found_angled_include_not_fatal

  # Off: bibo.hxx and hal.hxx are umbrella headers, so every include they list reads as
  # unused.
  UnusedIncludes: None
  MissingIncludes: None

  # Added to the root .clangd's list. firmware/.clang-tidy has the reasons for the check and
  # its option; keep the two in step, since neither reads the other.
  ClangTidy:
    Add:
      - hicpp-signed-bitwise

    CheckOptions:
      hicpp-signed-bitwise.IgnorePositiveIntegerLiterals: true
