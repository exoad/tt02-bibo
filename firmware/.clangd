# Fallback flags for the firmware, for any tool that parses these files WITHOUT
# the CMake project loaded.
#
# firmware/ is a separate CMake project - it cross-compiles for arm-none-eabi
# while the root project is MSVC x64 - so until it is attached in the IDE, a file
# here belongs to no project and every include is underlined at once. Nothing is
# wrong with the code: firmware/build/compile_commands.json has the full include
# set, and build.bat writes it on every configure. CompilationDatabase points the
# parser at it.
#
# THIS IS A FALLBACK. Attaching the project is the fix:
#
#     File | Attach Project...  ->  firmware/CMakeLists.txt
#     then pick the "Pico 2 W (RP2350, arm-none-eabi)" preset

CompileFlags:
  CompilationDatabase: build

  # For the ARM cross-compiler; a host parser does not understand them and
  # reports each as an unknown argument.
  Remove:
    - -mcpu=*
    - -mthumb
    - -mfloat-abi=*
    - -mfpu=*
    - --specs=*

  # THE STANDARD LIBRARY, SPELLED OUT. The database names arm-none-eabi-g++, and
  # clangd guesses the LLVM embedded toolchain's header layout for it, which does
  # not exist here - so <cstddef> fails and every Int32 in shared.hxx reads as an
  # unknown type. These are what `arm-none-eabi-g++ -x c++ -E -v` prints, in its
  # order. HARDCODED, 13.3.0 included, like ARMBIN in build.bat: if the MSYS2
  # toolchain moves or updates, re-run that command and paste the new list.
  Add:
    - -isystem
    - C:/msys64/mingw64/arm-none-eabi/include/c++/13.3.0
    - -isystem
    - C:/msys64/mingw64/arm-none-eabi/include/c++/13.3.0/arm-none-eabi
    - -isystem
    - C:/msys64/mingw64/arm-none-eabi/include/c++/13.3.0/backward
    - -isystem
    - C:/msys64/mingw64/lib/gcc/arm-none-eabi/13.3.0/include
    - -isystem
    - C:/msys64/mingw64/lib/gcc/arm-none-eabi/13.3.0/include-fixed
    - -isystem
    - C:/msys64/mingw64/arm-none-eabi/include

Diagnostics:
  # The SDK's own headers are not ours to fix.
  Suppress:
    - pp_file_not_found_angled_include_not_fatal

  # OFF: bibo.hxx and hal.hxx are umbrella headers, so every include they list
  # is "unused" by the file that lists it. The warning would fire on the design
  # rather than on a mistake.
  UnusedIncludes: None
  MissingIncludes: None

  # clangd MERGES every .clangd from the file's directory up to the root, so this
  # adds to the root's check list. firmware/.clang-tidy says why the check is
  # scoped here; keep the two in step, since neither format reads the other.
  ClangTidy:
    Add:
      - hicpp-signed-bitwise

    CheckOptions:
      # Without this the literal 8 in `x >> 8` reports, which is a fact about
      # C++ and not about the file.
      hicpp-signed-bitwise.IgnorePositiveIntegerLiterals: true
