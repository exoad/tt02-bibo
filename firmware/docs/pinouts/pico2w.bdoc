<Doc title="Pico 2 W pinout" subtitle="all forty pads" category="Boards" id="pico2wPinout">

<!--
  A PINOUT, and nothing else: the diagram.

  No prose. What this car has wired to which pad belongs on a page that pulls
  this in with

      <Include file="pinouts/pico2w.bdoc"/>

  A pinout you have to read is a pinout you cannot use with a connector already
  in your other hand.
-->

<Draw width="1740" height="1010">
# The board, and a row per pad. Generated - see scratchpad/picopin.py.

setColor grey
setWidth 2
drawRect 720 66 1000 920

# USB, the only thing on the board that says which way round you are holding it.
setColor brWhite
setWidth 1
drawRect 820 40 900 66
setColor grey
setTextSize 12
setTextAlign centre
drawText 860 44 "USB"
drawText 860 487 "Raspberry Pi Pico 2 W"
setTextAlign left

