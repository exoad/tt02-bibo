drawCircle 401 42 3.2
drawCircle 418 42 3.2
drawCircle 435 42 3.2

setColor blue
setWidth 2
drawLine 40 62 228 62
drawLine 250 62 438 62
# The break itself, drawn as the thing it is rather than as an absence.
setColor white
setWidth 1.5
drawLine 234 57 244 67
drawLine 234 67 244 57
setColor blue
setWidth 1
drawCircle 44 52 3.2
