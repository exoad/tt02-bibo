# ---- one column of five highlighted, which is the unit of connection.
setColor #2E442E
fillRect 139 82 153 166
setColor green
drawCircle 146 90 3.2
drawCircle 146 107 3.2
drawCircle 146 124 3.2
drawCircle 146 141 3.2
