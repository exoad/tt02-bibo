drawCircle 435 52 3.2

setColor brCyan
setTextSize 10
drawText 215 15 "SPLIT HERE"
setColor red
drawText 460 35 "+ rail: TWO halves"
setColor blue
drawText 460 49 "- rail: TWO halves"
setColor grey
drawText 460 65 "bridge them, or the"
drawText 460 77 "two ends are separate"

