# This directory's database, not firmware/build's: pilot/ is host code, built with MSVC on the
# laptop and g++ on the Orange Pi, never with the Pico's toolchain. The database is
# hand-written; a .cxx with no entry of its own borrows a listed file's command.
CompileFlags:
  CompilationDatabase: .

  # The parent firmware/.clangd adds the ARM libstdc++ -isystem paths, and clangd merges
  # fragments. A deeper Remove runs after the parent's Add and strips each flag's argument.
  Remove:
    - -isystem
