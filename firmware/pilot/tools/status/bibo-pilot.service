[Unit]
Description=bibo pilot - the car, driven from the viewer, armed only by the viewer's ARM
After=network.target

[Service]
User=jack
# install.sh rewrites this line with the build directory and the lidar and Pico by
# their /dev/serial/by-id names. --manual, not --arm: nobody is at the car at boot,
# so only a viewer's ARM arms it.
ExecStart=/home/jack/build-pilot-app/pilot --manual --lidar /dev/ttyUSB0 --pico /dev/ttyACM0
# Exit 1 (the lidar or Pico will not open) retries; exit 0 (asked to stop) stays
# stopped. RestartSec outlasts lidar::open's wait and keeps under the start limit.
# A car program needs both devices:
#   sudo systemctl stop bibo-pilot    before it
#   sudo systemctl start bibo-pilot   after it
Restart=on-failure
RestartSec=5
# SIGTERM runs the pilot's shutdown, which sends the Pico STOP.
TimeoutStopSec=10
# dialout and video are the user's own groups; no capability is granted.
NoNewPrivileges=yes

[Install]
WantedBy=multi-user.target
