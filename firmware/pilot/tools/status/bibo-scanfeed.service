[Unit]
Description=bibo scan feed - the lidar's revolutions on TCP 8011 for the hub
After=network.target

[Service]
User=jack
# install.sh rewrites this path to the build directory on this board. The
# binary is only built with the lidar SDK (-DPILOT_RPLIDAR_SDK), so install.sh
# says so when it is not there yet rather than installing a unit that fails.
ExecStart=/home/jack/build-pilot-app/scanfeed /dev/ttyUSB0
Restart=on-failure
RestartSec=2
# Idle costs nothing: with no client connected the lidar is closed and the
# serial port is free for the pilot. A client that connects while the pilot
# holds the port is relayed to the pilot's own feed on 8012 (README, "Seeing
# the lidar from the hub"); nothing here needs stopping for the car to drive.
# No port below 1024 and no device the user cannot already open (dialout), so
# no capability is granted.
NoNewPrivileges=yes

# ON WHENEVER THE BOARD IS. This used to start only on the phone's hotspot, on
# the reasoning that at home the board is reached over ssh anyway. Then the Pi
# went ON THE CAR, and a feed that only exists on the hotspot is a feed that is
# missing on the bench - while wiring the car, which is exactly when you want
# to look at it. Idle it costs nothing - no client, no lidar.
[Install]
WantedBy=multi-user.target
