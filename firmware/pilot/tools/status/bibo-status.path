[Unit]
Description=bibo: restart the status page when its files change

[Path]
# A `git pull` puts new files on disk; a running service keeps serving the old
# ones from memory until restarted, and only root can restart it. This watches
# the server and the page's files (install.sh rewrites the paths to the
# checkout) and restarts the page for you, so "pull, reload" is the whole
# routine in the field.
PathModified=/home/jack/tt02-bibo/firmware/pilot/tools/status/status_server.py
PathModified=/home/jack/tt02-bibo/firmware/pilot/tools/status/dash
Unit=bibo-status-restart.service

[Install]
WantedBy=paths.target
