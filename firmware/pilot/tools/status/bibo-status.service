[Unit]
Description=bibo status page - the car's one URL
After=network.target

[Service]
User=jack
# install.sh rewrites this path to wherever the checkout actually is.
ExecStart=/usr/bin/python3 /home/jack/tt02-bibo/firmware/pilot/tools/status/status_server.py
Restart=on-failure
RestartSec=2
# Port 80 without root: the one capability the bind needs, and nothing else.
AmbientCapabilities=CAP_NET_BIND_SERVICE
NoNewPrivileges=yes

# Deliberately NOT enabled at boot. NetworkManager's dispatcher starts it when
# the WhoopWhoop hotspot comes up and stops it when it goes down - see
# 90-bibo-status beside this file. `systemctl start bibo-status` by hand works
# any time, for testing on another network. There is no [Install] section, so
# `systemctl enable` has nothing to do - that is intended.
