[Unit]
Description=bibo status page - the car's one URL
After=network.target

[Service]
User=jack
# install.sh rewrites this path to wherever the checkout actually is.
ExecStart=/usr/bin/python3 /home/jack/tt02-bibo/firmware/pilot/tools/status/status_server.py
Restart=on-failure
RestartSec=2
# Port 80 without root: the one capability the bind needs, and nothing else.
AmbientCapabilities=CAP_NET_BIND_SERVICE
NoNewPrivileges=yes

# ON WHENEVER THE BOARD IS. This used to start only on the phone's hotspot, on
# the reasoning that at home the board is reached over ssh anyway. Then the Pi
# went ON THE CAR, and the rule's real effect was that the dashboard was dead
# every time the hotspot happened to be off - including while wiring the car on
# the bench, which is exactly when you want to look at it.
[Install]
WantedBy=multi-user.target
