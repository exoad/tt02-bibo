# firmware/ only, on top of the root .clang-tidy. hicpp-signed-bitwise is scoped
# here because at the root it fires on ImGui, Win32 and D3D11 flag ORs: their
# unscoped int enums count as signed and cannot be combined without a cast on
# every call. Every line under firmware/ is ours.
#
# IgnorePositiveIntegerLiterals keeps the 8 in `x >> 8` from reporting.

InheritParentConfig: true

Checks: >
  hicpp-signed-bitwise

CheckOptions:
  - key: hicpp-signed-bitwise.IgnorePositiveIntegerLiterals
    value: true
