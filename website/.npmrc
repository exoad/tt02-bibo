# npm 10.9.0 fails on Nuxt's dependency graph with
#
#     npm error Cannot read properties of null (reading 'edgesOut')
#
# It is a resolver bug, not a network or cache problem: a plain `npm i is-odd`
# in the same shell succeeds, `npm i nuxt` does not, and clearing the cache
# changes nothing. Installing with legacy peer resolution avoids the code path.
#
# Here rather than in a README instruction, so `npm install` works on its own.
legacy-peer-deps=true
